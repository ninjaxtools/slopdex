{
  "name": "@ninjaxtools/slopdex",
  "version": "0.19.0",
  "description": "Semantic indexing and search for source callables and Markdown documentation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninjaxtools/slopdex.git"
  },
  "type": "module",
  "bin": {
    "slopdex": "scripts/native-launcher.mjs"
  },
  "files": [
    "Cargo.toml",
    "Cargo.lock",
    "src/",
    "native/*/slopdex",
    "native/*/slopdex.exe",
    "docs/implementation.md",
    "docs/reference.md",
    "README.md",
    "scripts/native-*.mjs",
    "scripts/smoke.mjs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install": "node scripts/native-install.mjs",
    "build": "cargo build --locked --release --bin slopdex",
    "dev": "cargo run --locked --bin slopdex --",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "typecheck": "cargo check --locked --all-targets",
    "clippy": "cargo clippy --locked --all-targets -- -D warnings",
    "test": "cargo test --locked",
    "test:run": "cargo test --locked",
    "test:npm": "node --test scripts/native-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "install:local": "npm run build && npm install -g .",
    "release:check": "npm run check && dist generate --check && dist plan",
    "prepack": "npm run build && npm run smoke",
    "check": "npm run fmt:check && npm run typecheck && npm run clippy && npm run test:run && npm run test:npm && npm run build && npm run smoke"
  }
}
