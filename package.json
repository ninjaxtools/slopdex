{
  "name": "@ninjaxtools/slopdex",
  "version": "0.11.0",
  "description": "Tree-sitter callable-level semantic indexing, search, and duplicate discovery for Python, JavaScript, TypeScript, Rust, Go, Java, and C",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninjaxtools/slopdex.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "slopdex": "dist/cli.js"
  },
  "files": [
    ".agents/skills/slopdex/SKILL.md",
    "dist",
    "docs/implementation.md",
    "README.md",
    "scripts/install-opencode-skill.mjs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "install:skill:opencode": "node scripts/install-opencode-skill.mjs",
    "publish:minor": "npm version minor && npm publish --access public",
    "prepack": "npm run build && npm run smoke",
    "check": "npm run typecheck && npm run test:run && npm run build && npm run smoke",
    "check:parser-parity": "node --import tsx scripts/check-parser-parity.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "ai": "^7.0.99",
    "ignore": "^7.0.9",
    "install": "^0.13.0",
    "js-tiktoken": "^1.0.21",
    "sqlite-vec": "^0.1.9",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "0.21.4",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "0.23.2",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
